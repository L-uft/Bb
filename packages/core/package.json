{
  "name": "@bb/core",
  "version": "0.1.0",
  "private": true,
  "description": "Bb core logic ported from Riff's server.js. No React Native or Node built-ins; runs in Node 22 (tests) and Hermes (app).",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:live": "cross-env LIVE=1 vitest run test/live",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
